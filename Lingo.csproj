<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Lingo.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>Lingo</AssemblyName>
    <RootNamespace>Lingo</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Lingo</Product>
    <AssemblyTitle>Lingo</AssemblyTitle>
    <Description>轻量级 Windows 剪贴板翻译工具</Description>
    <Copyright>Copyright © 2026 Lingo</Copyright>
    <!-- 参考项目仅作阅读参考，排除出编译范围 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);参考项目\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Lingo.ico" LogicalName="Lingo.Assets.Lingo.ico" />
    <EmbeddedResource Include="Assets\MaterialSymbolsRounded.ttf" LogicalName="Lingo.Assets.MaterialSymbolsRounded.ttf" />
  </ItemGroup>

</Project>
